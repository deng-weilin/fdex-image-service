# Copy this file to .env.production and replace every placeholder.
APP_ENV=production
HOST=0.0.0.0
PORT=4310
APP_ORIGIN=https://images.example.com
DATA_DIR=/app/runtime

SEED_DEMO_ACCOUNTS=false
ALLOW_REGISTRATION=false
COOKIE_SECURE=true
TRUST_PROXY=false
INITIAL_CREDITS=0
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_INITIAL_CREDITS=0

CREDITS_GENERATE=10
CREDITS_EDIT=4
DUPLICATE_SUBMIT_WINDOW_MS=3000
QUEUE_DELAY_MS=10
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=300000

IMAGE_PROVIDER=mock
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_API_STYLE=openai
IMAGE_GENERATE_MODEL=gpt-image-1
IMAGE_EDIT_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=png
IMAGE_RESPONSE_FORMAT=
IMAGE_TEXT_OVERLAY=false
