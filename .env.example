# Application
APP_ENV=development
PORT=4310
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4310
DATA_DIR=./runtime

# Development demo accounts. Production refuses to start with these enabled.
SEED_DEMO_ACCOUNTS=true
DEMO_PASSWORD=change-this-demo-password
ALLOW_REGISTRATION=true
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional first administrator. Set a unique password of at least 12 characters.
ADMIN_USERNAME=instructor
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_PASSWORD=
ADMIN_INITIAL_CREDITS=500

# Credits are teaching points, not currency.
CREDITS_GENERATE=10
CREDITS_EDIT=4
INITIAL_CREDITS=100
DUPLICATE_SUBMIT_WINDOW_MS=3000
QUEUE_DELAY_MS=10

# Authentication throttling per client IP.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=300000

# Environment values bootstrap the service. An administrator can override them from the web System Settings page without a restart.
IMAGE_PROVIDER=mock
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_API_STYLE=openai
IMAGE_GENERATE_MODEL=gpt-image-1
IMAGE_EDIT_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=png
# Leave empty for gpt-image-1. Set b64_json only for a compatible provider that requires it.
IMAGE_RESPONSE_FORMAT=

# On Windows, live generations can ask the model for a clean product background
# and draw Chinese titles, dimensions and labels locally with System.Drawing.
IMAGE_TEXT_OVERLAY=true
